# Local development only. Use a secret manager in deployed environments.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
APP_ADDRESS=127.0.0.1:3000
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
RUST_LOG=info,tower_http=info
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-from-openssl-rand-hex-32

# Reusable application metadata and token policy
APP_NAME=Rust Backend
APP_DESCRIPTION=Rust project management API
JWT_ISSUER=rust-service
JWT_AUDIENCE=rust-service-api
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set false when a trusted ingress provides shared rate limiting.
APP_RATE_LIMIT_ENABLED=true
# Seed only: explicitly choose ADMIN to bootstrap an installation.
# SEED_EMAIL=admin@example.com
# SEED_PASSWORD=set-a-strong-development-password
# SEED_ROLE=ADMIN
