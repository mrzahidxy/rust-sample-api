@baseUrl = http://127.0.0.1:3000
@token = paste-access-token-here
@refreshToken = paste-refresh-token-here
@projectId = 00000000-0000-0000-0000-000000000000
@taskId = 00000000-0000-0000-0000-000000000000

### Health
GET {{baseUrl}}/health

### Readiness
GET {{baseUrl}}/ready

### Register user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{"email":"user@example.com","password":"a-strong-development-password","name":"Sample User"}

### Login (copy access_token and refresh_token from response)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{"email":"admin@example.com","password":"a-strong-development-password"}

### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Create project
POST {{baseUrl}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Website redesign","description":"Plan and deliver the redesign"}

### List projects
GET {{baseUrl}}/api/projects?page=1&limit=20
Authorization: Bearer {{token}}

### Add task
POST {{baseUrl}}/api/projects/{{projectId}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{"title":"Create wireframes","priority":2,"due_date":"2027-01-15"}

### List tasks
GET {{baseUrl}}/api/projects/{{projectId}}/tasks?page=1&limit=20
Authorization: Bearer {{token}}

### Update task status
PATCH {{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"status":"IN_PROGRESS"}

### Refresh session
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{"refresh_token":"{{refreshToken}}"}

### Revoke current session
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{token}}
